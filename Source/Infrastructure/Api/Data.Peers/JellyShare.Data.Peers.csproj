<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>JellyShare.Data.Peers</AssemblyName>
    <RootNamespace>JellyShare.Data.Peers</RootNamespace>
    <AssemblyVersion>0.0.0.1</AssemblyVersion>
    <FileVersion>0.0.0.1</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JellyShare.UnitTests" />
    <InternalsVisibleTo Include="JellyShare.JellyfinTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Domain\JellyShare.Domain.csproj" />
  </ItemGroup>

  <!-- Jellyfin's host provides Microsoft.Extensions.*: compile against them, never ship or flow them. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

</Project>
