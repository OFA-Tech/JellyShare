<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>JellyShare.JellyfinTests</AssemblyName>
    <RootNamespace>JellyShare.JellyfinTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <!-- Runtime copies of the Jellyfin assemblies (the plugin project excludes them from output). -->
    <PackageReference Include="Jellyfin.Controller" />
    <PackageReference Include="Jellyfin.Model" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Source\Domain\JellyShare.Domain.csproj" />
    <ProjectReference Include="..\..\Source\Application\JellyShare.Application.csproj" />
    <ProjectReference Include="..\..\Source\Infrastructure\Api\Data.Peers\JellyShare.Data.Peers.csproj" />
    <ProjectReference Include="..\..\Source\Infrastructure\Data\Data.Files\JellyShare.Data.Files.csproj" />
    <ProjectReference Include="..\..\Source\Infrastructure\Platform\Media\JellyShare.Media.csproj" />
    <ProjectReference Include="..\..\Source\Infrastructure\Platform\Jellyfin\JellyShare.Jellyfin.csproj" />
  </ItemGroup>

  <!-- The fakes for the Domain ports are shared with the unit tests (compiled into this assembly too). -->
  <ItemGroup>
    <Compile Include="..\UnitTests\Fakes\*.cs" Link="Fakes\Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
    <Using Include="JellyShare.UnitTests.Fakes" />
  </ItemGroup>

</Project>
